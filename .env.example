# Copy to .env to override defaults. Everything is optional in development.

# API server port (the Vite dev server proxies /api to this).
PORT=4000

# REQUIRED in production (min 16 chars). In development a secret is generated and stored in server/data/.jwt_secret.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# SQLite file location (relative to the project root).
# DATABASE_PATH=server/data/resqchain.db

# Comma-separated browser origins allowed to call the API cross-origin (not needed with the Vite proxy or single-port production).
# CORS_ORIGIN=https://your-frontend.example.com

# Set to 1 (or the number of hops) when running behind a reverse proxy / load balancer so rate limits see real client IPs.
# TRUST_PROXY=1

# Display timezone for timestamps like "9:42 AM".
APP_TIMEZONE=Asia/Kolkata

# NGO / Government sign-up. If a code is set it is required on the Sign Up form.
# If left blank: sign-up for these roles is open in development and DISABLED in production.
NGO_INVITE_CODE=
GOV_INVITE_CODE=
